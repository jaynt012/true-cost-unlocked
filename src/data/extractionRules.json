  "ratePeriodAfterPattern": "^\\s*(?:(?:per|each|/)\\s*(day|week|fortnight|month|year|annum)s?\\b|(?:a|an)\\s+(day|week|fortnight|month|year)\\b|(daily|weekly|fortnightly|monthly|annually|yearly)\\b|p\\.?\\s*a\\.?)",

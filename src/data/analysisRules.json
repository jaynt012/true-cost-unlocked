{
  "segmentation": {
    "abbreviations": ["Rs.", "Inc.", "No.", "approx.", "vs.", "e.g.", "i.e.", "etc.", "Ltd.", "Mr.", "Mrs.", "Dr.", "St.", "U.S.", "U.K."]
  },
  "polarity": {
    "negators": ["\\b(?:no|not|none|never|neither|nor)\\b", "\\b(?:don['’]t|doesn['’]t|won['’]t|cannot|can['’]t)\\b", "\\bwithout(?!\\s+(?:notice|consent|permission|agreement))\\b|\\bfree\\s+of\\b", "\\b(?:waiv(?:e|ed)(?!\\s+(?:(?:your|the|any)\\s+)?(?:rights?|class))|exempt)\\b"],
    "zeroPatterns": ["(?:[$₹€£¥]|\\b(?:USD|INR|EUR|GBP|Rs\\.?))\\s*0(?:\\.0+)?(?![\\d.])", "\\b(?:zero|nil|none|waived)\\b", "\\b0(?:\\.0+)?\\s*%"],
    "scopeBreaks": [",?\\s*\\b(?:but|however|only|except|instead|yet|then|thereafter)\\b", ",(?!\\s*(?:or|and)\\b)", "\\band\\s+(?=(?:(?:we|you|they|it)\\s+)?(?:no\\b|not\\b|do\\s+not|don['’]t))"],
    "nonNegatingPatterns": ["\\bnot\\s+refundable\\b", "\\bnot\\s+optional\\b", "\\b(?:rights?|class[- ]action)[^.;]{0,60}\\bwaived\\b"],
    "laterAmountPattern": "\\b(?:then|thereafter|afterwards|subsequently|after\\s+(?:the\\s+)?(?:first\\s+)?\\d+|following\\s+(?:the\\s+)?grace)\\b",
    "conditionalPatterns": ["\\b(?:if|unless|when|upon|after|subject\\s+to|may|might|could)\\b"],
    "hypotheticalPatterns": ["\\b(?:for\\s+example|suppose|hypothetically|illustration|illustrative)\\b"],
    "conditionPattern": "\\b(?:if|unless|when|provided that|only if|after|upon|following|during|for the first|within)\\s+[^.;]+"
  },
  "protectionPolicy": { "inherentRiskReductionPerTerm": 1, "maximumInherentRiskReduction": 5 },
  "scenarioPeriods": { "gracePattern": "\\b(?:during|for|within)\\s+(?:the\\s+)?(?:first\\s+)?(?<count>\\d+)\\s*(?<unit>days?|weeks?|months?|years?)\\b", "daysPerUnit": { "day": 1, "week": 7, "month": 30, "year": 365 } },
  "rateAttributes": {
    "types": [
      { "type": "variable", "pattern": "\\b(?:variable|adjustable|floating)\\b|(?:linked|tied)\\s+to\\s+(?:the\\s+)?(?:prime|benchmark)" },
      { "type": "introductory", "pattern": "\\b(?:introductory|promotional|teaser)\\b" },
      { "type": "fixed", "pattern": "\\bfixed(?:[- ]rate|\\s+(?:apr|interest|rate))\\b|\\b(?:apr|interest(?:\\s+rate)?|rate)\\b[^.;]{0,20}\\bfixed\\b" },
      { "type": "fixed", "pattern": "\\brate\\b[^.;]{0,45}\\b(?:will\\s+not|does\\s+not|won['’]t|never)\\s+(?:change|increase)\\b", "acceptedPolarities": ["negated"] }
    ],
    "flatPattern": "\\bflat\\b|add[- ]on\\s+(?:rate|interest)|on\\s+(?:the\\s+)?original\\s+principal",
    "reducingPattern": "\\breducing\\b|declining\\s+(?:balance|principal)|on\\s+(?:the\\s+)?(?:daily\\s+)?balance",
    "aprPattern": "\\b(?:apr|annual\\s+percentage\\s+rate)\\b",
    "flatPricingProducts": ["payday", "gold_loan", "rent_to_own"]
  },
  "protectionCatalog": [
    { "id": "fixed_rate", "label": "Fixed rate", "pattern": "\\bfixed(?:[- ]rate|\\s+(?:apr|interest|rate))\\b|\\b(?:apr|interest(?:\\s+rate)?|rate)\\b[^.;]{0,20}\\bfixed\\b", "explanation": "The stated rate is fixed rather than variable.", "acceptedPolarities": ["asserted"] },
    { "id": "fixed_rate", "label": "Fixed rate", "pattern": "\\brate\\b[^.;]{0,45}\\b(?:will\\s+not|does\\s+not|won['’]t|never)\\s+(?:change|increase)\\b", "explanation": "The agreement says the rate will not change.", "acceptedPolarities": ["negated"] },
    { "id": "rate_lock", "label": "Rate lock", "pattern": "\\brate\\s+(?:lock(?:ed)?|guarantee)\\b", "explanation": "A documented lock protects the quoted rate for the stated period.", "acceptedPolarities": ["asserted", "conditional"] },
    { "id": "cancellation_window", "label": "Cancellation window", "pattern": "\\b(?:cancel|cancellation|withdraw|cooling[- ]off|rescind)\\b[^.;]{0,70}\\b\\d+\\s*(?:days?|hours?)\\b", "disallowedPatterns": ["\\b(?:cannot|can\\s+not|may\\s+not|not\\s+(?:allowed|permitted)\\s+to|unable\\s+to|don['’]t|do\\s+not)\\s+(?:cancel|withdraw|rescind)\\b"], "explanation": "A stated cancellation or cooling-off window can allow withdrawal under the listed conditions.", "acceptedPolarities": ["asserted", "negated", "waived/zero", "conditional"] },
    { "id": "grace_period", "label": "Grace period", "pattern": "\\bgrace\\s+period\\b", "explanation": "The stated grace period limits charges during the documented window.", "acceptedPolarities": ["asserted", "waived/zero", "conditional"] },
    { "id": "arbitration", "label": "No compulsory arbitration", "pattern": "\\b(?:binding\\s+|mandatory\\s+)?arbitration\\b", "explanation": "The agreement excludes the stated arbitration requirement.", "acceptedPolarities": ["negated", "waived/zero"] }
  ],
  "monetaryBases": [
    { "id": "interest", "pattern": "(?:on|of)\\s+(?:the\\s+)?(?:total\\s+)?interest(?:\\s+component)?|interest\\s+component" },
    { "id": "outstanding", "pattern": "(?:of|on)\\s+(?:the\\s+)?(?:outstanding|remaining)\\s+(?:principal|balance)|outstanding\\s+(?:principal|balance)" },
    { "id": "principal", "pattern": "(?:of|on)\\s+(?:the\\s+)?(?:original\\s+)?(?:principal|amount\\s+financed|loan\\s+amount)" },
    { "id": "emi", "pattern": "(?:of|on)\\s+(?:the\\s+)?(?:emi|installment|payment)" },
    { "id": "fee", "pattern": "(?:of|on)\\s+(?:the\\s+)?fee|fee\\s+amount" },
    { "id": "transaction", "pattern": "(?:of|on)\\s+(?:each\\s+)?transaction|transaction\\s+amount" }
  ],
  "rateRoleRules": [
    { "role": "penalty", "pattern": "penal\\s+interest|penalty\\s+(?:apr|rate|interest)|default\\s+(?:apr|rate|interest)|overdue\\s+(?:apr|rate|interest)|late\\s+(?:payment\\s+)?interest|delay\\s+interest|interest\\s+on\\s+(?:an?\\s+)?overdue" },
    { "role": "tax", "pattern": "\\b(?:gst|vat|hst|pst|sales\\s+tax|tax(?:es)?)\\b" },
    { "role": "fee_percent", "pattern": "\\b(?:fee|fees|charge|charges|commission|processing|origination)\\b|%\\s+of\\s+(?:the\\s+)?(?:loan|principal|amount)" },
    { "role": "discount", "pattern": "\\b(?:discount|rebate|cashback|savings|off)\\b" },
    { "role": "promotional", "pattern": "\\b(?:introductory|promotional|teaser|deferred|interest[- ]free|no[- ]interest)\\b|for\\s+the\\s+first\\s+\\d+\\s+(?:months?|years?)" },
    { "role": "base", "pattern": "\\b(?:apr|annual\\s+percentage\\s+rate|interest(?:\\s+rate)?|rate)\\b" }
  ],
  "quantityRelationships": {
    "percentOfPattern": "(?<percent>\\d+(?:\\.\\d+)?)\\s*%\\s*of\\s+(?<baseLabel>loan\\s+amount|amount\\s+financed|principal|cash\\s+price|purchase\\s+price|amount\\s+borrowed|credit\\s+amount)[^.;]*?\\((?<derived>[^()]*)\\)",
    "references": [
      { "id": "principal", "pattern": "loan\\s+amount|amount\\s+financed|principal|amount\\s+borrowed|credit\\s+amount", "candidatePattern": "loan\\s+amount|amount\\s+financed|principal|amount\\s+borrowed|credit\\s+amount" },
      { "id": "cash_price", "pattern": "cash\\s+price|purchase\\s+price", "candidatePattern": "cash\\s+price|purchase\\s+price|vehicle\\s+price" }
    ]
  },
  "inherentRiskProfiles": [
    { "documentType": "installment_loan", "weight": 0, "reason": "Standard installment credit; individual pricing and contract findings determine the risk score." },
    { "documentType": "bnpl", "weight": 3, "reason": "Deferred or split payments can carry fees and conditional interest." },
    { "documentType": "auto_loan", "weight": 3, "reason": "Vehicle financing can include collateral recovery and financed add-ons." },
    { "documentType": "mortgage", "weight": 3, "reason": "Property-secured credit can expose the borrower to loss of collateral." },
    { "documentType": "credit_card", "weight": 5, "reason": "Revolving balances can compound and remain open-ended." },
    { "documentType": "payday", "weight": 18, "reason": "Short-term credit commonly creates high-cost repayment pressure." },
    { "documentType": "rent_to_own", "weight": 20, "reason": "Missed payments may forfeit prior payments or delay ownership." },
    { "documentType": "gold_loan", "weight": 12, "reason": "Pledged collateral may be sold after default." },
    { "documentType": "subscription", "weight": 0, "reason": "Recurring-payment terms are scored from renewal, cancellation, and fee findings." },
    { "documentType": "advance_fee_scam", "weight": 20, "reason": "Upfront-payment demands before credit delivery require fraud review." },
    { "documentType": "unknown", "weight": 0, "reason": "Document type is unclassified; detected terms determine the risk score." }
  ],
  "riskBandThresholds": { "medium": 30, "high": 60, "confidence": 0.7 },

    { "id": "negative_principal_label", "pattern": "\\b(?:emi|monthly\\s+payments?|payments?|installments?|instalments?|fees?|charges?|tax(?:es)?|limits?|deposit|down\\s+payment|discount|coverage|insurance|gap|apr|interest\\s+rate|term|tenure|tenor|duration|period)\\b", "score": -160, "kind": "exclude" }
  ],
  "documentTypes": [
    { "id": "bnpl", "label": "Buy now, pay later / no-cost EMI", "signals": [{ "pattern": "buy[- ]?now[- ]?pay[- ]?later|bnpl", "weight": 8 }, { "pattern": "pay\\s+in\\s+\\d+\\s+installments?", "weight": 5 }, { "pattern": "no[- ]cost\\s+emi|interest[- ]free\\s+installments?", "weight": 5 }] },
    { "id": "auto_loan", "label": "Auto loan", "signals": [{ "pattern": "auto\\s+loan|vehicle\\s+loan|motor\\s+vehicle", "weight": 8 }, { "pattern": "vehicle\\s+identification\\s+number|\\bvin\\b|dealer\\s+fee", "weight": 4 }, { "pattern": "gap\\s+(?:coverage|insurance)", "weight": 3 }] },
    { "id": "mortgage", "label": "Mortgage", "signals": [{ "pattern": "mortgage|home\\s+loan|real\\s+property", "weight": 8 }, { "pattern": "escrow|property\\s+tax|loan-to-value", "weight": 3 }] },
    { "id": "credit_card", "label": "Credit card / revolving credit", "signals": [{ "pattern": "credit\\s+card|cardholder|revolving\\s+credit", "weight": 8 }, { "pattern": "minimum\\s+payment|cash\\s+advance", "weight": 3 }] },
    { "id": "payday", "label": "Payday / short-term loan", "signals": [{ "pattern": "payday|cash\\s+advance\\s+loan|short[- ]term\\s+loan", "weight": 8 }, { "pattern": "due\\s+on\\s+your\\s+next\\s+payday", "weight": 4 }] },
    { "id": "rent_to_own", "label": "Rent-to-own", "signals": [{ "pattern": "rent[- ]to[- ]own|lease[- ]to[- ]own|early\\s+purchase\\s+option", "weight": 10 }] },
    { "id": "gold_loan", "label": "Gold-backed loan", "signals": [{ "pattern": "gold\\s+loan|gold\\s+jewell?ery|pledged\\s+gold", "weight": 8 }, { "pattern": "assaying\\s+charge|loan-to-value", "weight": 2 }] },
    { "id": "subscription", "label": "Subscription", "signals": [{ "pattern": "subscription|recurring\\s+membership|monthly\\s+membership", "weight": 6 }, { "pattern": "cancel\\s+anytime|auto[- ]renew", "weight": 3 }] },
    { "id": "advance_fee_scam", "label": "Possible advance-fee scam", "signals": [{ "pattern": "guaranteed\\s+approval|no\\s+credit\\s+check", "weight": 3 }, { "pattern": "upfront\\s+(?:insurance|processing|release)\\s+fee", "weight": 4 }, { "pattern": "wire\\s+transfer|gift\\s+card|crypto(?:currency)?\\s+payment", "weight": 5 }] },
    { "id": "installment_loan", "label": "Installment loan", "signals": [{ "pattern": "installment\\s+loan|personal\\s+loan|loan\\s+agreement|amount\\s+financed|loan\\s+amount|principal", "weight": 3 }, { "pattern": "apr|annual\\s+percentage\\s+rate|repayment\\s+period|loan\\s+term", "weight": 1 }] }
  ],
  "feeCatalog": [
    { "id": "origination", "label": "Origination fee", "patterns": ["origination\\s+fee", "loan\\s+setup\\s+fee"], "category": "upfront_fee", "severity": 2, "explanation": "Upfront charge for creating or setting up the credit." },
    { "id": "processing", "label": "Processing fee", "patterns": ["processing\\s+fee", "administrative\\s+fee"], "category": "upfront_fee", "severity": 2, "explanation": "Upfront processing or administration charge." },
    { "id": "convenience", "label": "Convenience fee", "patterns": ["convenience\\s+fee", "transaction\\s+fee"], "category": "recurring_fee", "severity": 2, "explanation": "Charge applied for processing a payment or transaction." },
    { "id": "late_payment", "label": "Late or missed-payment fee", "patterns": ["late\\s+(?:(?:payment|installment|instalment)\\s+)?fee", "missed\\s+(?:payment|installment|instalment)\\s+fee", "overdue\\s+fee"], "category": "penalty", "severity": 3, "explanation": "Charge triggered by a late or missed payment." },
    { "id": "general_fees", "label": "General fees", "fallbackOnly": true, "patterns": ["\\b(?:hidden|extra|additional)\\s+(?:fees?|charges?)\\b", "\\bfees?\\s*:\\s*(?:nil|none|zero)\\b", "\\bfee\\s+of\\s+any\\s+kind\\b"], "category": "upfront_fee", "severity": 2, "explanation": "The clause describes a general transaction charge." },
    { "id": "reschedule", "label": "Rescheduling fee", "patterns": ["reschedul(?:e|ing)\\s+fee"], "category": "penalty", "severity": 2, "explanation": "Charge for moving a payment date." },
    { "id": "annual", "label": "Annual fee", "patterns": ["annual\\s+fee", "yearly\\s+fee"], "category": "recurring_fee", "severity": 2, "explanation": "Recurring annual account charge." },
    { "id": "balance_transfer", "label": "Balance-transfer fee", "patterns": ["balance\\s+transfer\\s+fee"], "category": "upfront_fee", "severity": 2, "explanation": "Charge for transferring a balance." },
    { "id": "cash_advance", "label": "Cash-advance fee", "patterns": ["cash\\s+advance\\s+fee"], "category": "upfront_fee", "severity": 3, "explanation": "Charge for a cash advance." },
    { "id": "foreign_transaction", "label": "Foreign-transaction fee", "patterns": ["foreign\\s+transaction\\s+fee"], "category": "upfront_fee", "severity": 1, "explanation": "Charge on foreign-currency transactions." },
    { "id": "payment_protection", "label": "Payment-protection add-on", "patterns": ["payment\\s+protection\\s+plan", "payment\\s+insurance", "credit\\s+insurance"], "category": "financed_addon", "severity": 3, "explanation": "Optional or financed payment-protection product; verify enrollment and cancellation terms." },
    { "id": "gap", "label": "GAP coverage add-on", "patterns": ["gap\\s+(?:coverage|insurance|protection)"], "category": "financed_addon", "severity": 3, "explanation": "Vehicle add-on that may cover a shortfall between vehicle value and loan balance." },
    { "id": "service_contract", "label": "Service contract or warranty add-on", "patterns": ["service\\s+contract", "extended\\s+warranty"], "category": "financed_addon", "severity": 2, "explanation": "Optional protection product that may be included in the financed amount." },
    { "id": "tax_interest", "label": "Tax on interest or fees", "patterns": ["(?:gst|vat|sales\\s+tax)\\s+(?:on|of)\\s+(?:interest|fees?)", "tax(?:es)?\\s+on\\s+(?:interest|fees?)"], "category": "tax", "severity": 2, "explanation": "Tax assessed on interest or loan fees." },
    { "id": "prepayment", "label": "Prepayment or foreclosure charge", "patterns": ["prepayment\\s+(?:penalty|charge|fee)", "foreclosure\\s+(?:charge|fee|penalty)"], "category": "prepayment", "severity": 2, "explanation": "Charge for repaying or closing the loan early." },
    { "id": "negative_equity", "label": "Rolled-in negative equity", "patterns": ["negative\\s+equity", "roll(?:ed)?\\s+over\\s+(?:the\\s+)?(?:old\\s+)?loan\\s+balance", "prior\\s+loan\\s+balance"], "category": "negative_equity", "severity": 3, "explanation": "Prior debt may be rolled into the new financing." },
    { "id": "forfeiture", "label": "Forfeiture of prior payments", "patterns": ["forfeit(?:ure|s|ed)?\\s+(?:of\\s+)?(?:prior|previous|past|all|any)?\\s*(?:payments?|amounts?|rent|installments?)", "forfeit\\w*[^.;]{0,35}\\b(?:payments?|amounts?|rent|installments?)\\b", "lose\\s+(?:all\\s+)?(?:prior|previous|past)?\\s*(?:payments?|amounts?|rent)", "(?:prior|previous|past)\\s+(?:payments?|rent|installments?)\\s+(?:will\\s+be|are|is|become)\\s+(?:forfeited|nonrefundable|not\\s+refunded)", "(?:payments?|rent|amounts?)\\s+already\\s+paid\\s+(?:will\\s+be|are|is)\\s+(?:forfeited|kept|not\\s+refunded)"], "category": "forfeiture", "severity": 5, "minimumRiskBand": "high", "riskReason": "The agreement can forfeit amounts already paid.", "explanation": "Prior payments may be kept or forfeited if the agreement ends early or payments are missed." },
    { "id": "collateral_recovery", "label": "Collateral repossession or auction", "patterns": ["repossession|repossess(?:ed|ion)?", "seiz(?:e|ure)\\s+(?:of\\s+)?(?:the\\s+)?(?:pledged\\s+)?(?:collateral|asset|vehicle|property|gold|goods)", "auction(?:s|ed|ing)?\\s+(?:of\\s+)?(?:the\\s+)?(?:pledged\\s+)?(?:collateral|asset|vehicle|property|gold|goods)", "(?:collateral|asset|vehicle|property|gold|goods)\\s+(?:may\\s+be\\s+)?(?:seized|sold|auctioned|recovered|repossessed)", "(?:pledged\\s+)?(?:collateral|asset|vehicle|property|gold|goods)[^.;]{0,45}\\b(?:seized|sold|auctioned|recovered|repossessed)\\b"], "category": "collateral_recovery", "severity": 5, "minimumRiskBand": "high", "riskReason": "The lender may seize or sell collateral after default.", "explanation": "The agreement permits recovery or sale of pledged property after a missed-payment trigger." },
    { "id": "acceleration_cross_default", "label": "Acceleration or cross-default", "patterns": ["accelerat(?:e|ed|ion)\\s+(?:the\\s+)?(?:entire\\s+)?balance", "cross[- ]default", "entire\\s+balance\\s+becomes\\s+(?:immediately\\s+)?due"], "category": "default_terms", "severity": 4, "minimumRiskBand": "medium", "riskReason": "A default can make a larger balance due or trigger default across agreements.", "explanation": "A missed obligation may accelerate repayment or trigger default under another agreement." },
    { "id": "ownership_after_final_payment", "label": "Ownership only after final payment", "patterns": ["ownership\\s+(?:transfers?|vests?)\\s+only\\s+after\\s+(?:the\\s+)?(?:final|last)\\s+payment", "own(?:er|ership)?\\s+(?:the\\s+)?(?:item|property|asset|vehicle|goods)?\\s*only\\s+after\\s+(?:all\\s+)?payments?", "title\\s+(?:transfers?|passes)\\s+only\\s+after\\s+(?:the\\s+)?(?:final|last)\\s+payment", "become\\s+(?:the\\s+)?owner\\s+only\\s+after\\s+(?:the\\s+)?(?:final|last)\\s+payment", "ownership[^.;]{0,70}\\b(?:after|once|when)\\s+(?:all|the\\s+last|the\\s+final)\\s+(?:scheduled\\s+)?payments?\\s+(?:are\\s+)?(?:made|paid|completed)", "(?:asset|item|property|vehicle|goods|title|ownership)[^.;]{0,70}\\b(?:transfers?|passes|vests?)[^.;]{0,70}\\b(?:after|once|when)\\b[^.;]{0,70}\\b(?:all|final|last)\\s+(?:scheduled\\s+)?(?:payments?|installments?|instalments?)\\b[^.;]{0,30}\\b(?:made|paid|completed)\\b"], "category": "ownership_terms", "severity": 3, "minimumRiskBand": "medium", "riskReason": "The buyer does not own the item until all required payments are made.", "explanation": "Ownership is conditional on completing the full payment schedule." },
    { "id": "no_credit_check", "polarityOverride": "asserted", "label": "No-credit-check marketing", "patterns": ["no\\s+credit\\s+(?:check|needed|needed|required)|without\\s+a\\s+credit\\s+check"], "category": "pricing_access_signal", "severity": 3, "riskReason": "No-credit-check marketing can accompany high-cost or restrictive terms; verify the total payable and ownership conditions.", "explanation": "No-credit-check access is a pricing-risk signal and does not establish that the offer is affordable." },
    { "id": "early_purchase_option", "label": "Early-purchase option", "patterns": ["early[- ]purchase\\s+option", "option\\s+to\\s+(?:purchase|buy)\\s+(?:the\\s+)?(?:item|property|asset)?\\s*early", "early\\s+buy[- ]out"], "category": "contract_option", "severity": 1, "explanation": "The agreement describes an option to purchase before the scheduled end." },
    { "id": "penal_rate", "label": "Penal or overdue interest rate", "patterns": ["penal\\s+interest", "penalty\\s+(?:apr|rate|interest)", "default\\s+(?:apr|rate|interest)", "overdue\\s+(?:apr|rate|interest)", "late\\s+(?:payment\\s+)?interest", "delay\\s+interest"], "category": "penalty", "severity": 4, "minimumRiskBand": "high", "riskReason": "The stated rate applies because of late payment or default, not to the ordinary balance.", "explanation": "This is a conditional default rate and is separate from the agreement's base rate." },
    { "id": "upfront_deduction", "label": "Amount deducted from proceeds", "patterns": ["(?:deduct(?:ed|ing)?|withheld)\\s+(?:upfront\\s+)?from\\s+(?:the\\s+)?(?:loan\\s+)?(?:proceeds|disbursal|disbursement|advance)", "upfront\\s+deduction\\s+from\\s+(?:the\\s+)?(?:proceeds|disbursal|disbursement)"], "category": "upfront_fee", "severity": 3, "suppressWhen": ["(?:processing|origination|administrative)\\s+fee"], "explanation": "An upfront amount is withheld from the cash proceeds even if the loan balance remains unchanged." },
    { "id": "advance_fee_demand", "label": "Payment demanded before credit is released", "patterns": ["(?:upfront|advance|release|clearance|insurance)\\s+(?:fee|charge|deposit|payment)[^.;]{0,100}\\b(?:before|prior\\s+to|to\\s+release|for\\s+release)\\b[^.;]{0,100}\\b(?:loan|credit|funds|disbursal|disbursement|advance)\\b", "\\b(?:before|prior\\s+to)\\b[^.;]{0,80}\\b(?:loan|credit|funds|disbursal|disbursement)\\b[^.;]{0,70}\\b(?:pay|send|wire|transfer|deposit)\\b[^.;]{0,50}\\b(?:fee|charge|payment|deposit)\\b"], "category": "fraud", "severity": 5, "minimumRiskBand": "high", "riskReason": "A fee is demanded before the promised credit or funds are released.", "explanation": "An advance payment before credit delivery is a strong fraud warning." },
    { "id": "unilateral_term_change", "label": "Unilateral change to rates or terms", "patterns": ["(?:we|lender|creditor|provider)[^.;]{0,100}\\b(?:may|can|reserve the right to)\\b[^.;]{0,70}\\b(?:unilaterally\\s+)?(?:change|modify|increase|revise)\\b[^.;]{0,60}\\b(?:terms|rates|fees|charges|payment)\\b", "\\b(?:terms|rates|fees|charges|payment)[^.;]{0,70}\\b(?:may|can)\\s+be\\s+(?:changed|modified|increased|revised)\\b[^.;]{0,70}\\b(?:without\\s+notice|at\\s+our\\s+discretion|unilaterally)\\b"], "category": "legal", "severity": 4, "minimumRiskBand": "medium", "riskReason": "The provider can change rates, fees, or terms without the borrower's agreement.", "explanation": "A unilateral change clause can make the repayment terms uncertain." }
    ,{ "id": "dealer_compensation", "label": "Dealer compensation or markup", "patterns": ["dealer\\s+(?:may\\s+)?receive\\s+compensation", "dealer\\s+compensation", "dealer\\s+markup", "kickbacks?", "commissions?"], "category": "conflict_of_interest", "severity": 3, "explanation": "The dealer or intermediary may receive compensation tied to this transaction." },
    { "id": "discount_offset", "label": "Discount or interest offset", "patterns": ["\\b(?:instant\\s+)?discount\\b", "\\bcashback\\b", "\\brebate\\b", "\\boffset\\s+credit\\b", "discount.{0,60}(?:offset|interest)|offset.{0,60}discount"], "category": "offset", "severity": 0, "explanation": "A stated discount or cashback offsets the transaction cost." },
    { "id": "generic_tax", "label": "Tax on financing cost", "patterns": ["(?:(?:gst|vat|hst|pst|sales\\s+tax)\\s*(?:(?:@|at)\\s*)?\\d+(?:\\.\\d+)?%|tax(?:es)?\\s*(?:(?:@|at)\\s*)?\\d+(?:\\.\\d+)?%)", "tax(?:es)?\\s+(?:of|at)\\s+\\d+(?:\\.\\d+)?%"], "category": "tax", "severity": 2, "explanation": "Tax is applied to a stated financing amount or basis." }
  ],
  "claimCatalog": [
    { "id": "no_cost", "label": "No-cost claim", "pattern": "no[- ]cost|100%\\s+free|completely\\s+free", "predicates": ["listed_charge", "positive_net_cost"] },
    { "id": "free", "label": "Free claim", "pattern": "(?<!interest[- ])\\bfree\\b", "predicates": ["listed_charge"] },
    { "id": "no_fees", "label": "No-fees claim", "pattern": "no\\s+(?:additional\\s+)?fees?|zero\\s+fees?", "predicates": ["listed_charge"] },
    { "id": "interest_free", "label": "Interest-free claim", "pattern": "interest[- ]free|no\\s+interest|0%\\s+(?:apr|interest)", "predicates": ["positive_rate"] },
    { "id": "optional", "label": "Optional claim", "pattern": "optional|opt\\s+out", "predicates": ["included_despite_optional"] },
    { "id": "guaranteed", "label": "Guaranteed claim", "pattern": "guaranteed(?:\\s+approval|\\s+rate|\\s+acceptance)?", "predicates": ["conditional_guarantee"] },
    { "id": "conditional_language", "label": "Conditional wording", "pattern": "\\b(?:may|might|could)\\b", "predicates": ["hedge_word_present"] },
    { "id": "own_it_today", "label": "Immediate-ownership claim", "pattern": "own\\s+it\\s+today\\s+for\\s+just\\s+(?:[$€£₹]|Rs\\.?\\s*)?\\d+(?:,\\d{2,3})*(?:\\.\\d+)?\\s*(?:per|a)\\s+(?:day|week|month|year)", "predicates": ["ownership_after_all_payments"] },
    { "id": "no_credit_needed", "label": "No-credit-needed marketing", "pattern": "no\\s+credit\\s+(?:needed|required|check)|without\\s+a\\s+credit\\s+check", "predicates": ["predatory_pricing_signal"] }
  ],
  "riskRules": [
    { "id": "claim_contradiction", "category": "claims", "weight": 20, "pattern": "" },
    { "id": "deferred_interest", "category": "pricing", "weight": 20, "pattern": "deferred\\s+interest|retroactive(?:ly)?" },
    { "id": "arbitration_waiver", "category": "legal", "weight": 15, "pattern": "waive[\\s\\S]{0,120}class action|binding arbitration|class[- ]action[^.;]{0,80}rights?[^.;]{0,50}waived" },
    { "id": "automatic_optional_addon", "category": "claims", "weight": 15, "pattern": "automatically added[\\s\\S]{0,100}(?:opt out|unless you opt)" },
    { "id": "data_sharing", "category": "privacy", "weight": 8, "pattern": "share your data with partners|share data with partners" },
    { "id": "credit_reporting", "category": "credit", "weight": 8, "pattern": "report missed payments? to credit bureaus" },
    { "id": "penalty_apr", "category": "pricing", "weight": 15, "pattern": "\\bpenalty\\s*apr\\b" },
    { "id": "variable_rate", "category": "pricing", "weight": 8, "pattern": "\\b(?:variable|adjustable|floating)\\b[^.;]{0,80}\\b(?:prime\\s+rate|interest|apr|rate)\\b" },
    { "id": "indefinite_penalty", "category": "pricing", "weight": 10, "pattern": "\\b(?:penalty|apr|rate)\\b[\\s\\S]{0,80}\\bindefinitely\\b|\\bindefinitely\\b[\\s\\S]{0,80}\\b(?:penalty|apr|rate)\\b" },
    { "id": "promotional_rate", "category": "pricing", "weight": 5, "pattern": "\\b(?:introductory|promotional)\\s*(?:apr|rate)?\\b" },
    { "id": "high_apr", "category": "pricing", "weight": 15, "pattern": "" },
    { "id": "advance_fee_scam", "category": "fraud", "weight": 25, "pattern": "" }
    ,{ "id": "dealer_compensation", "category": "conflict_of_interest", "weight": 12, "pattern": "dealer\\s+(?:may\\s+)?receive\\s+compensation|dealer\\s+markup|kickbacks?|commissions?" },
    { "id": "no_credit_access_signal", "category": "pricing_access_signal", "weight": 8, "pattern": "no\\s+credit\\s+(?:check|needed|required)|without\\s+a\\s+credit\\s+check" }
  ],
  "riskCategoryCaps": { "claims": 30, "pricing": 30, "legal": 20, "privacy": 10, "credit": 10, "fraud": 30, "fees": 20, "document_type": 25, "conflict_of_interest": 20, "financed_addon": 20, "tax": 15, "penalty": 20, "forfeiture": 30, "collateral_recovery": 30, "default_terms": 25, "ownership_terms": 20, "pricing_access_signal": 20, "contract_option": 10 },
  "categoryGlossary": [
    { "category": "financed_addon", "term": "Financed add-on", "definition": "An optional product or item added to the financed amount can increase the payment and interest over the loan term." },
    { "category": "tax", "term": "Tax on financing cost", "definition": "A tax assessed on interest or fees increases the amount paid beyond the stated financing charge." },
    { "category": "offset", "term": "Discount or offset", "definition": "A discount or cashback reduces cost only to the extent that it is actually applied to the amount owed." },
    { "category": "upfront_fee", "term": "Upfront fee", "definition": "A one-time charge may be paid at signing or added to the financed balance." },
    { "category": "recurring_fee", "term": "Recurring fee", "definition": "A repeating charge can add to each payment or recur during the agreement." },
    { "category": "penalty", "term": "Penalty fee", "definition": "A contingent charge can apply after a missed payment or other specified event." },
    { "category": "prepayment", "term": "Prepayment charge", "definition": "A charge may apply when the balance is repaid before the scheduled end of the agreement." },
    { "category": "conflict_of_interest", "term": "Dealer compensation", "definition": "Dealer or intermediary compensation can create an incentive tied to a particular financing offer." },
    { "category": "negative_equity", "term": "Negative equity", "definition": "Prior debt may be rolled into a new agreement and increase the amount financed." },
    { "category": "undisclosed_amount", "term": "Unquantified amount", "definition": "A named charge or debt has no stated value, so the disclosed total may be incomplete." }
  ],
  "glossary": [
    { "id": "deferred_interest", "term": "Deferred interest", "pattern": "deferred\\s+interest|retroactive\\w*", "definition": "Interest may be charged later for an earlier promotional period if the required balance is not paid by its deadline." },
    { "id": "amount_financed", "term": "Amount financed", "pattern": "amount\\s+financed", "definition": "The amount of credit being advanced, which can include optional products and other rolled-in charges." },
    { "id": "gst_interest", "term": "GST on interest", "pattern": "(?:gst|tax)\\s+(?:on|of)\\s+interest", "definition": "Tax added to interest charges; it increases the total paid beyond the stated interest." },
    { "id": "foreclosure", "term": "Foreclosure charge", "pattern": "foreclosure", "definition": "A charge that may apply when a loan is paid off or closed before its scheduled end." },
    { "id": "gap", "term": "GAP coverage", "pattern": "gap\\s+(?:coverage|insurance|protection)", "definition": "Vehicle coverage that may pay some difference between the vehicle's value and the remaining loan balance after a covered loss." },
    { "id": "negative_equity", "term": "Negative equity", "pattern": "negative\\s+equity|roll(?:ed)?\\s+over", "definition": "Debt on a trade-in or prior loan that exceeds the asset's value and may be added to the new loan." },
    { "id": "no_cost_emi", "term": "No-cost EMI", "pattern": "no[- ]cost\\s+emi", "definition": "A marketing label for installments with no stated interest; fees, taxes, or a higher purchase price can still create a cost." }
    ,{ "id": "processing_fee", "term": "Processing fee", "pattern": "processing\\s+fee|administrative\\s+fee", "definition": "A charge for handling or setting up a transaction; check whether tax is added and whether it is financed." },
    { "id": "tax_interest_component", "term": "Tax on interest", "pattern": "(?:gst|vat|sales\\s+tax|tax)\\s*@?\\s*\\d+(?:\\.\\d+)?%[^.]{0,80}(?:interest|emi)|(?:gst|vat|sales\\s+tax|tax)[^.]{0,60}(?:interest\\s+component)", "definition": "A tax assessed on interest adds to the cost of borrowing, even when the stated installment is unchanged." },
    { "id": "discount_offset", "term": "Discount or offset", "pattern": "instant\\s+discount|cashback|rebate|discount[^.]{0,60}offset|offset[^.]{0,60}discount", "definition": "A discount, rebate, or cashback reduces the amount paid; its effect depends on whether it actually offsets financing costs." },
    { "id": "service_contract", "term": "Service contract", "pattern": "service\\s+contract|extended\\s+warranty", "definition": "An optional repair or protection product that may be financed with the loan and add interest." },
    { "id": "dealer_compensation", "term": "Dealer compensation", "pattern": "dealer\\s+(?:may\\s+)?receive\\s+compensation|dealer\\s+markup|kickbacks?|commissions?", "definition": "Compensation paid to a dealer or intermediary can create an incentive to offer a particular financing product or rate." },
    { "id": "unquantified_amount", "term": "Unquantified amount", "pattern": "negative\\s+equity|fees?\\s+may\\s+apply|other\\s+charges?\\s+may\\s+apply", "definition": "The document refers to a charge or debt without stating its amount, so the disclosed total may be incomplete." }
  ],
